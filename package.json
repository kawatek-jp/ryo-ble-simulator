{
  "name": "ryo-ble-simulator",
  "version": "0.1.0",
  "description": "Cross-platform BLE peripheral simulator for the RYO hand system. Emulates the kawable GATT service for mobile app testing.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js --verbose",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "ble",
    "bluetooth",
    "emg",
    "simulator",
    "peripheral",
    "gatt"
  ],
  "author": "Kawatek",
  "license": "MIT",
  "dependencies": {
    "@abandonware/bleno": "^0.6.2",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
